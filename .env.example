# OB1 Environment Variables Template
# Copy this file to .env and fill in your actual API keys

# Claude API Key (get from: https://console.anthropic.com/settings/keys)
CLAUDE_API_KEY=sk-ant-...

# OpenAI API Key (get from: https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-proj-...

# Cursor API Key (get from: https://cursor.com/settings)
CURSOR_API_KEY=key_...

# GitHub Personal Access Token (get from: https://github.com/settings/tokens)
GITHUB_TOKEN=ghp_...

# Optional: Codex CLI Key (alternative to OPENAI_API_KEY)
# CODEX_CLI_KEY=sk-...
